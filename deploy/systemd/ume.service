[Unit]
Description=Ume Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ume
Group=ume
WorkingDirectory=/var/lib/ume
EnvironmentFile=/etc/ume/ume.env
Environment=TMP_PATH=/var/umed/tmp
ExecStart=/usr/local/bin/ume
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/ume /var/umed

[Install]
WantedBy=multi-user.target
